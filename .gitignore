# scratch notes / audit drafts (never tracked)
.scratch/

# experiment artifacts (regenerable); eval RESULT files under runs/ are
# tracked deliberately (durable numbers) via the negations at the bottom
runs/*
__pycache__/
.cache/
.venv/

# Colab-glue exploratory walkthrough
google-colab-cli/

# debugging / one-off probes (kept for reference, not part of pipeline)
scripts/check_ckpt.py
scripts/check_upload.py
scripts/debug_lfm2.py
scripts/gpu_check.py
scripts/launch_detached.py
scripts/list_modules.py
scripts/tail_log.py
scripts/hold_test.py
scripts/probe_drive.py
scripts/probe_*.py

# checkpoint transfer artifacts (regenerable from Drive copy)
ckpt.tar.gz
adapters/lfm2_herdr_lora_old/

# validation report (regenerated by `make validate`)
validation_report.json

# training logs and eval snapshots
lfm2_train_dump*.log
# raw eval stdout is tracked; only .txt glob stays for OTHER contexts
# (negations below re-include runs/eval_*)
eval_*.txt
training-logs.txt

# ------------------------------------------------------------------ #
# durable eval results — versioned in git (numbers, not artifacts).
# Overrides the blanket rules above; must stay AFTER them.
# ------------------------------------------------------------------ #
!runs/eval_*.txt
!runs/eval_*.log
!runs/eval_*_summary.md
!runs/eval_*_holdout.json
!runs/caveats.md

# still-ignored noise inside runs/ (checkpoints, dumps, stderr)
runs/*.tar.gz
runs/*_dump.log
runs/*.err

# checkpoints and archives (regenerable)
adapter*.pkl
tuned*.cact
checkpoints/
lfm2_ckpt*.tar.gz
adapters/*/adapter_model.safetensors
adapters/*/tokenizer.json
adapters/*/tokenizer_config.json
adapters/*/chat_template.jinja
